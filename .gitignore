# Generated documents
*.pdf
*.docx

# MCP npm launcher sources (the root lib/ rule above would hide them)
!MCP/npm/lib/
!MCP/npm/lib/**

# MCP bundle build outputs (manifest, icon and build script stay tracked)
MCP/mcpb/dist/
*.mcpb

# Python server bundled into the npm package (generated by `npm pack` / prepack)
MCP/npm/python/
