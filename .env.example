# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (OpenAI-compatible endpoint) ---
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY="your_key_here"

# Per-role models. The Research Mode UI can override these per run.
LLM_MODEL_PLANNER="deepseek-chat"
LLM_MODEL_RESEARCHER="deepseek-chat"
LLM_MODEL_AGGREGATOR="deepseek-chat"

# --- Web search (DeepSearch mode) ---
TAVILY_API_KEY="your_key_here"

# --- Academic sources ---
# A real address is required by OpenAlex and Unpaywall for the polite pool.
OPENALEX_EMAIL="you@example.com"
# Optional. Raises the Semantic Scholar rate limit.
SEMANTIC_SCHOLAR_API_KEY=""
# Optional but free: https://core.ac.uk/services/api — recovers extra full texts.
CORE_API_KEY=""
# Required by NCBI E-utilities for PubMed. Both must be set or PubMed is skipped.
# Use a real, reachable address and your own tool name.
NCBI_EMAIL="you@example.com"
NCBI_TOOL_NAME="YourToolName"
# Optional. Raises the NCBI rate limit from 3 to 10 requests/second.
NCBI_API_KEY=""
# Optional. Canonicalizes leading author names through the ORCID public API and
# stores the ORCID iD on a confident match.
ORCID_AUTHOR_ENRICHMENT=0
# How many leading authors per paper to look up (1-10). Each costs one request.
ORCID_MAX_AUTHORS=2

# --- Configuration API access ---
# /config/setup rewrites this file and reloads the LLM clients, so it fails closed.
# Local development only: allow it with no authentication.
ALLOW_OPEN_CONFIG_API=0
# Deployed: set a token instead, sent by the UI as the X-Config-Token header.
CONFIG_API_TOKEN=""

# --- Storage paths & Live Stats ---
INITIAL_PAPER_COUNT=33
RESEARCH_DB_PATH="./data/research_state.db"
LLM_CACHE_PATH="./data/llm_cache.db"
FIGURES_DIR="./data/figures"
